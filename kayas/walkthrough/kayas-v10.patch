+function screenPointToGround(px, py, target) {
+  const rect = canvas.getBoundingClientRect();
+  if (!rect.width || !rect.height) return null;
+  const ndc = new THREE.Vector2((px / rect.width) * 2 - 1, -(py / rect.height) * 2 + 1);
+  scaleRaycaster.setFromCamera(ndc, camera);
+  return scaleRaycaster.ray.intersectPlane(groundPlane, target);
+}
+
+function chooseNiceScale(metersPerPixel, idealPixels) {
+  const target = Math.max(0.05, metersPerPixel * idealPixels);
+  const exponent = Math.floor(Math.log10(target));
+  const candidates = [];
+  for (let exp = exponent - 1; exp <= exponent + 1; exp += 1) {
+    const power = Math.pow(10, exp);
+    [1, 2, 5].forEach((factor) => candidates.push(factor * power));
+  }
+  let best = candidates[0];
+  let bestScore = Infinity;
+  candidates.forEach((value) => {
+    const px = value / metersPerPixel;
+    if (px < 62 || px > 190) return;
+    const score = Math.abs(px - idealPixels);
+    if (score < bestScore) { best = value; bestScore = score; }
+  });
+  return best;
+}
+
+function formatScaleValue(value) {
+  if (value >= 10) return Math.round(value).toString();
+  if (value >= 1) return (Math.round(value * 10) / 10).toString().replace(".", ",");
+  return (Math.round(value * 100) / 100).toString().replace(".", ",");
+}
+
+function updateScaleBar(force = false) {
+  if (!scaleControl || !scaleLine || !scaleMid || !scaleMax) return;
+  const now = performance.now();
+  if (!force && now - lastScaleUpdate < 120) return;
+  lastScaleUpdate = now;
+  const rect = canvas.getBoundingClientRect();
+  if (rect.width < 120 || rect.height < 120) return;
+  const samplePixels = Math.min(140, Math.max(90, rect.width * 0.11));
+  const x = Math.max(50, rect.width - Math.min(320, rect.width * 0.24));
+  const sampleRows = [rect.height * 0.78, rect.height * 0.68, rect.height * 0.58];
+  let metersPerPixel = NaN;
+  for (const y of sampleRows) {
+    const a = screenPointToGround(x, y, scaleGroundA);
+    const b = screenPointToGround(x + samplePixels, y, scaleGroundB);
+    if (a && b) {
+      const distance = a.distanceTo(b);
+      if (Number.isFinite(distance) && distance > 0.001 && distance < 1000) {
+        metersPerPixel = distance / samplePixels;
+        break;
+      }
+    }
+  }
+  if (!Number.isFinite(metersPerPixel)) {
+    const fovRadians = THREE.MathUtils.degToRad(camera.fov);
+    const visibleHeight = 2 * Math.max(camera.position.y, 1.68) * Math.tan(fovRadians / 2);
+    metersPerPixel = visibleHeight / Math.max(rect.height, 1);
+  }
+  const idealPixels = rect.width < 600 ? 92 : 126;
+  const meters = chooseNiceScale(metersPerPixel, idealPixels);
+  const width = THREE.MathUtils.clamp(meters / metersPerPixel, 62, 190);
+  scaleLine.style.width = `${width.toFixed(1)}px`;
+  scaleMid.textContent = formatScaleValue(meters / 2);
+  scaleMax.textContent = `${formatScaleValue(meters)} m`;
+  scaleControl.title = `Dinamik ölçek: ${formatScaleValue(meters)} metre = ${Math.round(width)} piksel`;
+}
